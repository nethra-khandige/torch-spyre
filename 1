# Probe, not a test: does a compiled REDUCTION over a reserved tensor follow
# the logical size? Pointwise ops pass (tests/inductor/
# test_dynamic_reservation_compile.py), but a reduction over the reserved dim
# reads the size as a loop extent, so a kernel could silently reduce over the
# wrong number of rows. Run from the torch-spyre repo dir:
#
#     python3 probe_reserved_reduction.py 2>&1 | tee probe_reduction_out.txt
#
# Changes nothing in the repo.
#
# Design: allocate at the full 630 rows so every row holds defined data, then
# shrink and regrow. The right answer at size n is the sum of the first n rows.
# Rows 560+ are filled with 100.0, so reducing over too many rows is easy to
# spot, and each result is matched against the sum over n, 630 and 560 rows to
# say which extent the kernel actually used.

import traceback

import torch
from torch._dynamo.utils import counters

import torch_spyre  # noqa: F401

DEVICE = torch.device("spyre")
MAX = 630
SPEC = {"min": 70, "max": MAX, "granularity": 70}
COLS = 1024
SIZES = [630, 140, 280, 560, 70]


def sum_dim0(a):  # reduces OVER the reserved dim
    return a.sum(dim=0)


def sum_dim1(a):  # reduces over the other dim; pointwise in the reserved dim
    return a.sum(dim=1)


def reference(x, rows, dim):
    return x[:rows].float().sum(dim=dim)


def rel_err(got, ref):
    if got.shape != ref.shape:
        return None
    return ((got - ref).abs().max() / ref.abs().max()).item()


def run_case(label, fn, dim):
    print(f"\n===== {label} (sum over dim {dim})")
    torch._dynamo.reset()
    counters.clear()
    torch.manual_seed(0)
    x = torch.rand(MAX, COLS, dtype=torch.float16)
    x[560:] = 100.0
    try:
        y = x.to(DEVICE, dynamic={0: SPEC})
    except Exception as e:  # noqa: BLE001 - a probe: report everything
        print(f"  reserve FAILED: {type(e).__name__}: {str(e)[:300]}")
        return
    compiled = torch.compile(fn)
    for n in SIZES:
        try:
            if y.size(0) != n:
                y.resize_((n, COLS))
            got = compiled(y).cpu().float()
        except Exception as e:  # noqa: BLE001
            print(f"  n={n:4d}: FAILED {type(e).__name__}: {str(e)[:300]}")
            traceback.print_exc(limit=3)
            continue

        want = rel_err(got, reference(x, n, dim))
        verdict = "OK" if want is not None and want < 5e-2 else "WRONG"
        matches = {
            rows: rel_err(got, reference(x, rows, dim))
            for rows in (n, 560, MAX)
        }
        closest = min(
            (r for r, e in matches.items() if e is not None),
            key=lambda r: matches[r],
            default=None,
        )
        print(
            f"  n={n:4d}: {verdict}  out={tuple(got.shape)}  "
            f"rel err vs sum over n rows={want if want is None else round(want, 4)}  "
            f"closest to sum over {closest} rows"
        )
    print(
        f"  counters: unique_graphs={counters['stats']['unique_graphs']} "
        f"frames_ok={counters['frames']['ok']} "
        f"cache_miss={counters['inductor']['fxgraph_cache_miss']}"
    )


run_case("reduce over the OTHER dim (expected OK)", sum_dim1, 1)
run_case("reduce OVER the reserved dim", sum_dim0, 0)

print(
    "\nReading it: for sum over dim 0, OK at every n means the kernel follows\n"
    "the logical size. WRONG with 'closest to sum over 630 rows' means it\n"
    "reduces over the max; 'closest to 630' at the first size and the same\n"
    "wrong extent afterwards means it baked in the compile-time size."
)

